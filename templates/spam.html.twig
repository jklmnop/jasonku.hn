{% extends 'base.html.twig' %}

{% block body %}
    <style>
        .spam-grid {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: start;
            gap: 1rem;
        }

        .spam {
            --top-left: transparent;
            --top-right: transparent;
            --bottom-left: transparent;
            --bottom-right: transparent;

            min-height: 300px;
            min-width: 300px;

            background:
                radial-gradient(circle at 10% 20%, var(--top-left) 0%, transparent 70%),
                radial-gradient(circle at 70% 30%, var(--top-right) 0%, transparent 60%),
                radial-gradient(circle at 30% 80%, var(--bottom-left) 0%, transparent 80%),
                radial-gradient(circle at 90% 90%, var(--bottom-right) 0%, transparent 50%),
                var(--bg);
            background-blend-mode: overlay;

            display: flex;
            align-items: end;
        }
    </style>

    {% include 'header.html.twig' %}

    <h2>Spamart</h2>
    <div class="spam-grid">
        {% for spam in spams %}
            <div class="spam"
                 style="
                    --top-left: #{{ spam.color1 }};
                    --top-right:#{{ spam.color2 }};
                    --bottom-left: #{{ spam.color3 }};
                    --bottom-right: #{{ spam.color4 }};
                    --bg: #{{ spam.colorBg }}
                "
            >
                <ul>
                    <li>{{ spam.spamScore }} on canvas</li>
                    <li>{{ spam.date|date('m/Y') }}</li>
                </ul>
            </div>
        {% endfor %}
    </div>
{% endblock %}
