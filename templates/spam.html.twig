<h2>Spamart</h2>
<div class="spam-grid">
    {% for spam in spams %}
        <div
             style="
                 --top-left: #{{ spam.color1 }};
                 --top-right:#{{ spam.color2 }};
                 --bottom-left: #{{ spam.color3 }};
                 --bottom-right: #{{ spam.color4 }};
                 --bg: #{{ spam.colorBg }};
                 --seed1: {{ random(-100,100) }}%;
                 --seed2: {{ random(-100,100) }}%;
                 --seed3: {{ random(-100,100) }}%;
                 --seed4: {{ random(-100,100) }}%;
             "
        >
            <span>{{ spam.message|default('') }}</span>

            <ul>
                <li>{{ spam.spamScore }} on canvas</li>
                <li>{{ spam.date }}</li>
            </ul>
        </div>
    {% endfor %}
</div>
